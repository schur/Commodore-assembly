; KERNAL / ROM entry points
        CHROUT  = $FFD2       ; Output character in A
        CHRIN   = $FFCF       ; Blocking character input
 
; PETSCII control Characters
        CR = $0D  ; return
        CLR = $93 ; clear screen
        LWRCS = $0E ; lower case
        UPRCS = $8E ; lower case

!macro print .message {
        lda #<.message
        sta PTRA
        lda #>.message
        sta PTRA+1
        jsr print_string
}

!macro read .buffer,.maxlen {
        lda #<.buffer
        sta PTRA
        lda #>.buffer
        sta PTRA+1
        lda #.maxlen
        jsr read_string
}


; print_string routine
; On entry:
;   PTRA / PTRA+1 = address of null-terminated string
; Uses A and Y; leavses PTRA unchanged as it prints.
!zone print_string
print_string:
        ldy #0
.loop   lda (PTRA),y
        beq .done
        jsr CHROUT
        iny
        beq .done ; stop after 256 characters
        jmp .loop
.done
        rts

; read_string routine
; On entry:
;   PTRA / PTRA+1 = destination buffer address
;   A = max number of characters to read
; Uses A and Y; 
; Stores a null-terminated string, up to 255 characters.
!zone read_string
read_string:
        sta .comp+1         ; self modifying code 
        ldy #0
.loop   jsr CHRIN
        cmp #CR
        beq .done
.comp   cpy #0              ; will be replaced with the value in A passed to the routine
        beq .loop           ; discard excess characters
        sta (PTRA),y
        iny
        jmp .loop
.done
        lda #0
        sta (PTRA),y
        rts

