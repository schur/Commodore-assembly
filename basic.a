
!if ARCH="PET" {
* = $0401  ; Start of PET BASIC Memory
}

!if ARCH="C64" {
* = $0801  ; Start of C64 BASIC Memory
}

!if ARCH="VIC20" {
    !if VIC20_RAM=0 {
        * = $1001  ; Start of VIC-20 BASIC Memory (no RAM expansion)
    }
    !if VIC20_RAM=3 {
        * = $0401  ; with 3K RAM expansion 
    }
    !if VIC20_RAM>=8 {
        * = $1201  ; with 8K or more RAM expansion
    }
}


; BASIC stub:  10 SYS <main> 

        !word basic_end
        !word 10            ; BASIC Line Number 10
        !byte $9e                   ; BASIC SYS token
        !byte $30 + (main / 1000)         ; calculated address of main:
        !byte $30 + ((main / 100) % 10)
        !byte $30 + ((main / 10) % 10)
        !byte $30 + (main % 10)
        !byte 0                            ; End of BASIC line
basic_end:
        !word 0                            ; End of BASIC program



