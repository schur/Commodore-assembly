; numbers.a - Commodore PET / ACME
        !to "main.prg", cbm

!source "basic.a"
!source "common.a"
!source "strgio.a"
!source "atoi.a"

!zone main
main:
        jsr CLRSCR              ; clear screen
       
.main_loop:
        +print prompt

        +read input_buffer      ; Read characters until Return
        lda #CR                 ; print newline
        jsr CHROUT

        lda input_buffer        ; empty line
        beq .end

        lda #<NUMBER            ; no need to load input_buffer into PTRA - still there
        sta PTRB
        lda #>NUMBER
        sta PTRB+1
        jsr atoi
        bcs .error

        ;+print msg1
        +print success
        jmp .main_loop
.error
        +print error
        jmp .main_loop
.end
        rts


prompt:
        !pet "Enter Number: ",0
msg1:
        !pet "You entered: ",0
error:
        !pet "Error: invalid input",CR,0
success:
        !pet "Valid number",CR,0
input_buffer:
        !fill INPUT_MAX+1,0

NUMBER:
        !word 0


