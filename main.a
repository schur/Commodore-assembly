!cpu 6502
!to "main.prg", cbm

ARCH="C64"                      ; Change this value to C64, VIC20, or PET
;VIC20_RAM=0                      ; set VIC20 expansion size in KB (0, 3, 8, 16 or 24)

!source "basic.a"
!source "common.a"              ; import needed library routines
!source "strgio.a"
!source "atoi.a"

!zone main
main:
        lda #CLR                ; clear screen
        jsr CHROUT
        lda #LWRCS              ; switch to lowercase
        jsr CHROUT
       
.main_loop:
        +print prompt

        +read input_buffer,2    ; Read characters until Return
        lda #CR                 ; print newline
        jsr CHROUT

        lda input_buffer        ; empty line
        beq .end

        lda #<NUMBER            ; no need to load input_buffer into PTRA - still there
        sta PTRB
        lda #>NUMBER
        sta PTRB+1
        jsr atoi
        bcs .error

        ;+print msg1
        +print success
        lda NUMBER
        jsr CHROUT
        lda #CR                 ; print newline
        jsr CHROUT

        jmp .main_loop
.error
        +print error
        jmp .main_loop
.end
        rts


prompt:
        !pet "Enter Number: ",0
msg1:
        !pet "You entered: ",0
error:
        !pet "Error: invalid input",CR,0
success:
        !pet "Valid number",CR,0

input_buffer = CAS_BUF      ; use cassette buffer for user input
INPUT_MAX = CAS_BUF_LEN -1  ; leave 1 byte for NULL byte terminator

NUMBER:
        !word 0


